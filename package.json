{
  "name": "disc-golf",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node backend/src/server.js",
    "postinstall": "npm install --prefix backend --omit=dev",
    "build": "npm install --prefix backend && npm install --prefix frontend --include=dev && npm run build --prefix frontend",
    "package:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-deploy.ps1"
  },
  "engines": {
    "node": "22.x"
  }
}
